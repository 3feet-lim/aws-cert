#!/usr/bin/env bash
# Manually trigger an agent-written commit message, then commit and push.
# Usage:
#   hooks/agent-commit-push
#   hooks/agent-commit-push --no-stage   # use only already-staged changes
#
# The script asks Codex CLI to inspect the staged diff and write a concise
# commit message. It then runs git commit and git push.
set -euo pipefail

stage_all=1
if [[ "${1:-}" == "--no-stage" ]]; then
  stage_all=0
  shift
fi
if [[ $# -gt 0 ]]; then
  echo "Usage: hooks/agent-commit-push [--no-stage]" >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ "$stage_all" -eq 1 ]]; then
  git add -A
fi

if git diff --cached --quiet; then
  echo "agent-commit-push: no staged changes to commit." >&2
  echo "Tip: run without --no-stage to stage all changes automatically." >&2
  exit 0
fi

branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [[ -z "$branch" ]]; then
  echo "agent-commit-push: detached HEAD; refusing to commit/push." >&2
  exit 1
fi

upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
if [[ -z "$upstream" ]]; then
  echo "agent-commit-push: no upstream for '$branch'. Set one first, e.g. git push -u origin $branch" >&2
  exit 1
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
input_file="$tmpdir/codex-input.md"
message_file="$tmpdir/commit-message.txt"

cat > "$input_file" <<'PROMPT'
You are writing a git commit message for the staged diff provided on stdin.
Return ONLY the commit message text, with no markdown fences and no explanation.
Follow this format:

<intent line: why the change was made, not what changed>

Tested: not run (commit message generated by hooks/agent-commit-push)

Rules:
- Intent line must be concise and specific.
- Prefer Korean if the file contents and project context are Korean; otherwise English is OK.
- Do not claim tests were run.
- Do not mention Codex or AI.
PROMPT

{
  echo
  echo "--- repository context ---"
  echo "Repository: $repo_root"
  echo "Branch: $branch"
  echo
  echo "Status:"
  git status --short
  echo
  echo "Staged diff stat:"
  git diff --cached --stat
  echo
  echo "Staged diff:"
  git diff --cached --find-renames --find-copies
} >> "$input_file"

codex -a never exec --cd "$repo_root" --sandbox read-only -o "$message_file" - < "$input_file" >/dev/null

# Normalize and lightly validate the generated message.
python3 - "$message_file" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
msg = path.read_text(encoding='utf-8', errors='replace').strip()
# Strip accidental markdown fences or labels.
if msg.startswith('```'):
    msg = msg.strip('`').strip()
for prefix in ('Commit message:', '커밋 메시지:', 'Message:'):
    if msg.lower().startswith(prefix.lower()):
        msg = msg[len(prefix):].strip()
lines = [line.rstrip() for line in msg.splitlines()]
while lines and not lines[0].strip():
    lines.pop(0)
if not lines or not lines[0].strip():
    raise SystemExit('agent-commit-push: Codex returned an empty commit message')
if len(lines[0]) > 120:
    lines[0] = lines[0][:117].rstrip() + '...'
path.write_text('\n'.join(lines).strip() + '\n', encoding='utf-8')
PY

echo "--- generated commit message ---" >&2
cat "$message_file" >&2
echo "--------------------------------" >&2

git commit -F "$message_file"
git push
